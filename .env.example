# ─────────────────────────────────────────────────────────────
# Umgebungsvariablen für den Backend-Server
#
# ANLEITUNG:
#   1. Diese Datei kopieren: cp .env.example .env
#   2. .env mit deinen echten Werten ausfüllen
#   3. .env wird NICHT auf GitHub gepusht (steht in .gitignore)
#      → Der API-Key bleibt geheim
# ─────────────────────────────────────────────────────────────

# ── Modus ──────────────────────────────────────────────────────
# "ollama"  → lokales Modell (Phase 1, kein Key nötig)
# "groq"    → Groq Cloud API (Phase 2, für Studententests)
SERVER_MODE=saia 

# ── Groq (Phase 2) ─────────────────────────────────────────────
# API-Key von https://console.groq.com
SAIA_API_KEY=a0c60320e37dde514932be20d0943d89


SAIA_MODEL=qwen2.5-72b-instruct

# ── Ollama (Phase 1) ───────────────────────────────────────────
# Nur ändern wenn Ollama auf einem anderen Port läuft
# LLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=llama3.2

# ── Server ─────────────────────────────────────────────────────
# Port auf dem der Backend-Server läuft
# PORT=3000

# ── Supabase ───────────────────────────────────────────────────
# Projekt-URL und Keys von https://supabase.com → Settings → API Keys
